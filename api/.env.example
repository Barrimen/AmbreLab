# En local, sans Postgres, l'API tombe automatiquement sur un fichier
# SQLite (local.db) si DATABASE_URL n'est pas défini.
# En production sur Railway, DATABASE_URL est injecté automatiquement
# quand tu attaches un service PostgreSQL au même projet - ne pas
# le définir toi-même dans les variables Railway.

# DATABASE_URL=postgresql://user:password@host:5432/dbname
